# ═══════════════════════════════════════════════════════════════
# Mwenje AI Tutor — Backend Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your own values

# ─── Server ─────────────────────────────────────────────────────
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# ─── Database (MySQL 8.0+) ──────────────────────────────────────
# Connection pool settings for tutorSessionRepository
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=mwenje

# Legacy DATABASE_URL (optional, for reference)
# DATABASE_URL=mysql://root:yourpassword@localhost:3306/mwenje

# ─── Claude API (AI Tutor) ───────────────────────────────────────
# Get your key from: https://console.anthropic.com/account/keys
CLAUDE_API_KEY=sk-ant-your-key-here

# ─── Hugging Face (Fallback AI) ──────────────────────────────────
# Optional: If you want to use Hugging Face Study Assistant as fallback
# HF_TOKEN=hf_your_token_here
# HF_STUDY_ASSISTANT_SPACE_URL=https://abhinaychatla-assistantstudy.hf.space

# ─── Redis (Optional, for caching & rate limiting) ───────────────
# REDIS_URL=redis://localhost:6379

# ─── Authentication ─────────────────────────────────────────────
# Use a long random string in production: openssl rand -hex 32
JWT_SECRET=mwenje-dev-secret-key-change-in-production

# ─── Logging (Optional) ──────────────────────────────────────────
# LOG_LEVEL=info

